import { randomUUID } from 'node:crypto'

function escape(value: string) { return value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]!)) }
export function recoveryHtml(details: string, dark: boolean) {
  const nonce = randomUUID()
  return `<!doctype html><html lang="zh-CN" style="color-scheme:${dark ? 'dark' : 'light'}"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'nonce-${nonce}'; base-uri 'none'; form-action 'none'"><title>星塔旅人 · 启动未完成</title><style>
  *{box-sizing:border-box}body{margin:0;font-family:'Segoe UI','Microsoft YaHei UI',sans-serif;background:var(--bg);color:var(--text);--bg:${dark ? '#10151c' : '#f2f7fb'};--surface:${dark ? '#1a222d' : '#fff'};--text:${dark ? '#e4ecf5' : '#243b4d'};--muted:${dark ? '#96a8ba' : '#7890a2'};--line:${dark ? '#303e4e' : '#dfe9f0'};--primary:${dark ? '#78b8df' : '#23769a'};--soft:${dark ? '#233c50' : '#e7f2f8'}}header{height:47px;display:flex;justify-content:space-between;align-items:center;padding:0 16px 0 25px;border-bottom:1px solid var(--line);-webkit-app-region:drag;font-size:11px;color:var(--muted)}button{font:inherit;cursor:pointer;border-radius:8px;border:1px solid var(--line);background:var(--surface);color:var(--text);padding:10px 17px;font-size:12px;-webkit-app-region:no-drag}header button{border:0;background:none;font-size:19px;padding:2px 9px;color:var(--muted)}button:hover{border-color:var(--primary);color:var(--primary)}button:focus-visible{outline:2px solid var(--primary);outline-offset:3px}button:disabled{opacity:.5;cursor:wait}main{padding:30px 34px}.heading{display:flex;gap:16px;align-items:center;margin-bottom:22px}.symbol{display:grid;place-items:center;background:var(--soft);border-radius:14px;width:50px;height:50px;color:var(--primary);font-size:29px}.heading small{color:var(--muted);font-size:9px;letter-spacing:1.4px}h1{font-size:25px;font-weight:650;margin:7px 0 0}p{font-size:12px;line-height:1.9;color:var(--muted);margin:0 0 20px}.details{background:var(--surface);border:1px solid var(--line);border-radius:11px;padding:17px 18px}.details h2{font-size:12px;font-weight:600;margin:0 0 12px}pre{font:11px/1.8 Consolas,'Microsoft YaHei UI',monospace;white-space:pre-wrap;overflow-wrap:anywhere;max-height:170px;min-height:95px;overflow:auto;margin:0;color:var(--muted);user-select:text}footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:24px}.actions{display:flex;gap:9px}.primary{background:var(--primary);border-color:var(--primary);color:${dark ? '#142231' : '#fff'}}.primary:hover{opacity:.9;color:${dark ? '#142231' : '#fff'}}#status{font-size:11px;color:var(--muted);min-height:20px;margin-top:15px}@media(max-height:550px){main{padding:22px 28px}pre{max-height:110px}p{margin-bottom:14px}}@media(prefers-reduced-motion:no-preference){main{animation:enter .24s ease}@keyframes enter{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}}
  </style></head><body><header><span>STELLA SORA · RECOVERY</span><button data-action="close" aria-label="关闭">×</button></header><main><div class="heading"><div class="symbol" aria-hidden="true">!</div><div><small>星塔旅人 · 故障恢复</small><h1>启动未完成</h1></div></div><p>界面暂时无法打开，错误信息已保留。可以重试启动，或复制详情后反馈。此页面不会修改招募归档。</p><section class="details"><h2>错误详情</h2><pre>${escape(details)}</pre></section><footer><button data-action="logs">打开日志目录</button><div class="actions"><button data-action="copy">复制详情</button><button class="primary" data-action="retry">重试启动</button></div></footer><div id="status" role="status"></div></main><script nonce="${nonce}">
  window.stellaRecovery.onStatus(message=>document.querySelector('#status').textContent=message);let busy=false;async function action(value){if(busy)return;busy=true;document.querySelectorAll('button').forEach(b=>b.disabled=true);try{const result=await window.stellaRecovery.perform(value);document.querySelector('#status').textContent=result?.message||''}catch(error){document.querySelector('#status').textContent=error.message||'操作未完成，请稍后重试'}finally{busy=false;document.querySelectorAll('button').forEach(b=>b.disabled=false)}}document.querySelectorAll('button[data-action]').forEach(b=>b.addEventListener('click',()=>action(b.dataset.action)));document.addEventListener('keydown',event=>{if(event.key==='Escape')action('close')});
  </script></body></html>`
}
